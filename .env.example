# Copy to .env and adjust. Never commit .env.

# --- App ---
APP_NAME=AdServe
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Postgres (step 3) ---
POSTGRES_USER=adserve
POSTGRES_PASSWORD=adserve
POSTGRES_DB=adserve
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://adserve:adserve@localhost:5432/adserve

# --- Redis (step 7) ---
REDIS_URL=redis://localhost:6379/0

# --- Kafka (step 8) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EVENTS_TOPIC=adserve.events
