{
  "uid": "adserve-overview",
  "title": "AdServe - Service Overview",
  "tags": ["adserve"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Auction requests/sec",
      "description": "Rate of POST /auction over the last minute. The throughput ceiling measured in STUDY_NOTES §23 was ~1080-1200 RPS.",
      "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
          "expr": "sum(rate(http_requests_total{handler=\"/auction\"}[1m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Fill rate",
      "description": "Share of auctions that found an eligible campaign. The remainder are 204 'no fill' responses - a normal outcome, not an error.",
      "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
          "expr": "sum(adserve_auction_wins_total) / clamp_min(sum(adserve_auction_wins_total) + sum(adserve_auction_no_fill_total), 1)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Suspicious clicks",
      "description": "Clicks flagged by the timing heuristic as implausibly fast after their impression (STUDY_NOTES §27). Flagged and recorded, never blocked.",
      "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
          "expr": "sum(adserve_suspicious_clicks_total)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Idempotent replays",
      "description": "Client retries answered from a stored Idempotency-Key response instead of being double-recorded (STUDY_NOTES §26). `or vector(0)` because a labelled counter does not appear in the metrics output at all until first incremented - without it this reads 'No data' on a fresh process rather than 0.",
      "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "purple" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
          "expr": "sum(adserve_idempotent_replays_total) or vector(0)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by endpoint",
      "description": "Per-handler throughput. /metrics traffic is Prometheus scraping this app every 5s - expected, not real user load.",
      "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
          "expr": "sum by (handler) (rate(http_requests_total[1m]))",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Auction latency percentiles",
      "description": "p50/p95/p99 for POST /auction, computed from the histogram buckets. Note these include the ~44ms Windows Docker port-forwarder artifact documented in STUDY_NOTES §19 - on Linux they would be far lower.",
      "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{handler=\"/auction\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{handler=\"/auction\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{handler=\"/auction\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Auction outcomes: wins vs no-fill",
      "description": "A rising no-fill rate means campaigns are running out of budget or targeting is too narrow - a business problem, not a system fault.",
      "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "stacking": { "mode": "normal" }, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
          "expr": "sum(rate(adserve_auction_wins_total[1m]))",
          "legendFormat": "wins"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
          "expr": "sum(rate(adserve_auction_no_fill_total[1m]))",
          "legendFormat": "no fill"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Non-2xx responses by status class",
      "description": "4xx includes 429s from the rate limiter (STUDY_NOTES §25) and 401s from API-key auth (§24) - both are the system working, not failing. Sustained 5xx is the one to worry about. An empty panel means no non-2xx responses have occurred since the process started, not a broken query.",
      "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "5xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "4xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "adserve-prometheus" },
          "expr": "sum by (status) (rate(http_requests_total{status!=\"2xx\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
